# ===========================
# Tenant identity (derived from filename — DO NOT set TENANT_ID here)
# ===========================
# The tenant ID is the stem of THIS file's name once you copy it:
#   cp tenants/example.env tenants/iaf.env   →  tenant ID = "iaf"
# Must match: ^[a-z0-9][a-z0-9_-]*$. Avoid the slug "example" (template-only).
# If you set TENANT_ID below AND it differs from the filename, gen-tenant errors
# out — pick one. Easiest: don't set TENANT_ID; the filename is the source of truth.
# TENANT_ID=<filename-stem>

# Added to every host-side port. Multiple of 100, range 0..9000.
# Suggested allocation: tenant-a=0, tenant-b=100, tenant-c=200, ...
# With offset 0   → MinIO API 9002, Console 9003, Milvus gRPC 19531, Health 9092, Redis 6379, App 8001
# With offset 100 → MinIO API 9102, Console 9103, Milvus gRPC 19631, Health 9192, Redis 6479, App 8101
PORT_OFFSET=0

# ===========================
# Infra hostnames (where the FastAPI app reaches each service)
# ===========================
# These determine the host part of the connection strings the app reads.
# Defaults to "localhost" — set to a LAN IP/DNS name when infra runs on a
# different machine than the app, mirroring the Dev/Prod toggle in .env.example.
# MILVUS_HOST=192.168.2.195
# MINIO_HOST=192.168.2.195
# REDIS_HOST=192.168.2.195

# ===========================
# MinIO credentials (per-tenant; defaults shown)
# ===========================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=rag-storage

# Public MinIO endpoint used ONLY for signing presigned GET URLs that the
# browser will follow. Set this when MinIO is fronted by a reverse proxy on a
# public DNS name (e.g. minio-<tenant>.example.com). The proxy must preserve
# the Host header so the SigV4 signature validates. Leave commented for
# single-host / dev setups — URLs will then be signed against MINIO__ENDPOINT.
# MINIO_PUBLIC_ENDPOINT=minio-<tenant>.example.com
# MINIO_PUBLIC_SECURE=true

# ===========================
# App env carried into .env.<tenant>
# ===========================
APP_ENV=dev

# Milvus collection names / vector config
MILVUS__CORPUS_COLLECTION_NAME=mavenir_rag_corpus
MILVUS__INPUT_COLLECTION_NAME=mavenir_rag_input
MILVUS__VECTOR_DIM=768
MILVUS__METRIC_TYPE=COSINE

# MinIO TLS toggle
MINIO__SECURE=false

# LLM
LLM__PROVIDER=ollama
LLM__OLLAMA_CHAT_MODEL=gemma3:4b
LLM__LITELLM_CHAT_MODEL=ollama/gemma3:4b
LLM__OLLAMA_EMBED_MODEL=nomic-embed-text
LLM__LITELLM_EMBED_MODEL=ollama/nomic-embed-text
LLM__OLLAMA_API_BASE=http://localhost:11434

# Document parser
DOC_PARSER__INCLUDE_HEADER_IN_CHUNK_CONTENT=true
DOC_PARSER__CHUNK_MAX_TOKENS=500
DOC_PARSER__TIKTOKEN_ENCODER=cl100k_base

# Keycloak
KEYCLOAK__SERVER_URL=https://dev-auth.mavenirites.net/auth
KEYCLOAK__REALM=RR
KEYCLOAK__CLIENT_ID=RR_DEV
KEYCLOAK__CLIENT_SECRET=
KEYCLOAK__VERIFY_SSL=false
KEYCLOAK__REQUEST_TIMEOUT_SECONDS=10
